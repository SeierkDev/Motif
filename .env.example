# Motif configuration.
#
# Everything has a working default except the keeper key, so a clone runs with
# no configuration at all against a local fork. The values that matter in
# production are marked.

# ---------------------------------------------------------------- the api
# api/

# Where the http and websocket server listens.
PORT=8787

# Where the SQLite file lives. On Railway this MUST be a mounted volume.
#
# It holds the recorded level history, and that is the only thing in this
# project that cannot be rebuilt: volume and fees are events and can be
# rescanned from the chain forever, but a level is a reading of a price that has
# already gone. Losing this directory loses it permanently.
DATA_DIR=/data

# The chain. PRODUCTION: use a dedicated endpoint, not this one.
#
# The public Robinhood rpc rate limits under real load and is not an archive
# node, so a long lived process will start seeing 429s and "metadata is not
# found". It is fine for tests, which re-fork at the head on every run.
MOTIF_RPC=https://rpc.mainnet.chain.robinhood.com

# Deployed contracts. Printed by script/Deploy.s.sol.
MOTIF_ROUTER=0x512F7469BcC83089497506b5df64c6E246B39925
MOTIF_REBALANCER=0x9fD16eA9E31233279975D99D5e8Fc91dd214c7Da
MOTIF_ORDERS=0x987e855776C03A4682639eEb14e65b3089EE6310

# Where a fresh index starts. Leave unset in production: it defaults to 200,000
# blocks back, which is the right answer once the contracts have been live a
# while. Set it to just before the deploy block for a faster first sync.
# MOTIF_FROM_BLOCK=

# ------------------------------------------------------------- the keeper
#
# WITHOUT THIS NOTHING FIRES. No stop loss, no limit, no rebalance. The keeper
# refuses to start rather than pretending to work, and /v1/status says so.
#
# This wallet needs gas and nothing else. It cannot move anyone's tokens: every
# call it makes is an operation a user already authorised through Permit2, and
# the contracts hold no balance for it to reach. Fund it with a little ETH and
# treat it as disposable.
#
# 0x followed by 64 hex digits, and no quotes. A hosting dashboard stores the
# quotes if you paste them, which is not a shell escaping them away. A missing
# prefix or a wrapped pair of quotes is repaired and logged; anything else is
# refused, and /v1/status says "bad key" and why. The api stays up either way.
MOTIF_KEEPER_KEY=

# How often it sweeps, and the ceiling on one attempt.
MOTIF_KEEPER_MS=20000
MOTIF_KEEPER_GAS_CAP=3000000

# -------------------------------------------------------------- the burner

# Optional. The address the deploy burner workflow prints. When set, the keeper
# asks it every few minutes whether ten dollars of protocol fee is waiting and
# burns it when it is, and /v1/burns lists every burn. Unset, neither happens
# and /v1/status says "no burner" rather than pretending.
#
# It needs no key of its own. The keeper's key calls it, and the fee wallet
# approves it once, from wherever that wallet lives. That wallet's key never
# belongs on this server.
# MOTIF_BURNER=

# How often the burner is asked, in milliseconds.
MOTIF_BURN_MS=300000

# -------------------------------------------------------------- the live feed

# How often each websocket client is pinged, in milliseconds. One that has not
# answered the previous ping when the next is due is dropped, so a dead one is
# gone within two of these. The default is right in production; CI sets it to a
# second so it can watch a dead client be dropped without waiting a minute.
MOTIF_WS_HEARTBEAT_MS=30000

# -------------------------------------------------------------- the levels
#
# How often a motif is priced and recorded. Every sweep that does not happen is
# a gap in the history that nobody can fill later, so faster is genuinely better
# here, bounded by what the rpc will take.
MOTIF_LEVEL_MS=60000

# --------------------------------------------------------------- the gate
# Requests a minute, per address. The api is keyless on purpose, which is not
# the same as being free to hammer.
MOTIF_RATE_LIMIT=240

# ---------------------------------------------------------------- the site
# web/
#
# NEXT_PUBLIC values are inlined at BUILD time, not read at run time, so they
# have to be present when the image is built. On Railway that means build args,
# not just service variables. This is the usual way a Next deploy ends up
# pointing at the wrong api.

# Where this deployment is reachable, used for canonical urls and for the Open
# Graph tags on every motif page. It MUST be the public origin: a link card
# cannot use a relative url, and getting this wrong fails silently, with every
# shared link unfurling without its image and nothing in any log.
NEXT_PUBLIC_SITE_URL=https://motif.fund

NEXT_PUBLIC_API=https://api.motif.fund

NEXT_PUBLIC_ROUTER=0x512F7469BcC83089497506b5df64c6E246B39925
NEXT_PUBLIC_REBALANCER=0x9fD16eA9E31233279975D99D5e8Fc91dd214c7Da
NEXT_PUBLIC_ORDERS=0x987e855776C03A4682639eEb14e65b3089EE6310

# Point the site at a local anvil fork instead of mainnet.
# NEXT_PUBLIC_LOCAL=1
